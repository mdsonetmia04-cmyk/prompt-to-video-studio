# ── Prompt to Video Studio · backend environment ─────────────────────────────
# Copy to backend/.env and fill in. Never commit real secrets.

# Server
PORT=8787
# Comma-separated origins allowed to call the API (frontend dev server default)
CORS_ORIGINS=http://localhost:5173

# ── AI generation (OpenAI-compatible chat-completions API) ───────────────────
# Leave AI_API_KEY empty to run in DEMO MODE: /api/generate returns 503 with
# setup instructions, and the built-in demo animation can be used instead.
AI_API_KEY=
# Base URL of a compatible API, e.g. https://api.openai.com/v1
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Max tokens the model may emit for one animation (keeps output bounded)
AI_MAX_TOKENS=12000
# HTTP timeout for generation requests, seconds
AI_TIMEOUT_SECONDS=90

# ── Rendering ────────────────────────────────────────────────────────────────
# Where render jobs live (job dirs, frames, mp4s). Relative = backend/renders.
RENDER_DIR=./renders
# Max concurrent Chromium+FFmpeg jobs; extra jobs queue.
MAX_CONCURRENT_JOBS=2
# Max queued jobs waiting; beyond this the API answers 429 + Retry-After.
MAX_QUEUE_LENGTH=10
# Whole-pipeline watchdog per job, minutes.
RENDER_TIMEOUT_MINUTES=10
# Delete finished/failed jobs (and their files) older than this, minutes.
JOB_TTL_MINUTES=60
# Optional explicit binaries (defaults: ffmpeg / ffprobe from PATH)
FFMPEG_PATH=
FFPROBE_PATH=
# Optional explicit Playwright browser executable (defaults to Playwright's
# downloaded Chromium)
CHROMIUM_EXECUTABLE_PATH=
